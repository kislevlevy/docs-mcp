# cp .env.example .env   (everything here is optional)

# Address the port is published on. 127.0.0.1 = local only.
# Set to the VM's Tailscale/WireGuard/LAN IP to reach it from another machine.
# Only use 0.0.0.0 if the VM is firewalled.
BIND_ADDR=127.0.0.1
PORT=8765

# Source synchronization (the Compose tool container mounts these paths).
SOURCES_CONFIG=sources.toml
STATE_DIR=.docs-mcp

# Empty = no auth (relies on the network being private).
# If set, clients must send: Authorization: Bearer <token>
AUTH_TOKEN=

# Browser origins allowed to call the endpoint. Requests with no Origin header
# (i.e. every MCP client) always pass; any other Origin is rejected with 403.
ALLOWED_ORIGINS=
# Optional Host allow-list, e.g. docs.internal:*  (blank = no Host check)
ALLOWED_HOSTS=

# Retrieval
RERANK=0                 # 1 = add a cross-encoder rerank pass (slower; see README Notes)
DEFAULT_LIMIT=8          # hits per search
CANDIDATES=50            # per-leg candidates before fusion
RERANK_POOL=40           # fused hits handed to the reranker

# Blank = use all cores. Lower it to leave CPU for other services on the VM.
THREADS=
CANDIDATE_MEMORY_MB=64  # larger source candidates spill to temporary storage

LOG_LEVEL=INFO
